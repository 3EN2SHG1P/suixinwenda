root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Windows PowerShell 5.1 只有带 BOM 才按 UTF-8 解析，否则中文全部变乱码（见 docs/踩坑与FAQ.md）
[*.ps1]
charset = utf-8-bom
