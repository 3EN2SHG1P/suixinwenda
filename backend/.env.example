# ============================================================
# 随心问答 后端环境变量模板
# 用法：复制本文件为 backend/.env，按下面注释逐项填写
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# backend/.env 已被 .gitignore 忽略，不会进仓库
# ============================================================

# ---------- 服务与地址 ----------
# run.py 用这两项绑定服务；桌面端托管启动时强制 127.0.0.1（写 0.0.0.0 会被拒绝）
# 手动跑 uvicorn 时命令行 --host / --port 优先
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010

# ---------- 数据库 ----------
# 取值：
#   sqlite  → 用本机文件库（默认，不需要装任何数据库）
#   mysql   → 用 MySQL 8（下面的 DB_* 才会被读）
#   留空    → 自动判断：写了 DB_HOST 就是 mysql，否则 sqlite。
#             老用户升级后本项为空、DB_HOST 是实值 → 自动继续用 MySQL，数据不受影响
DB_BACKEND=sqlite

# 以下仅 DB_BACKEND=mysql 时需要（用 SQLite 时整段保持注释即可）：
#   本机已经有 MySQL → 把 DB_USER / DB_PASSWORD / DB_NAME 改成你那份的，并先建好空库
#   本机没有 → 用仓库根目录 docker-compose.yml 起一个容器（docker compose up -d），
#             下面这套默认值与它完全对应，不用改
# 下面的口令与 docker-compose.yml 保持一致；连自己已有的 MySQL 时改成你自己的账号口令
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=123456
# DB_NAME=suixinwenda
# 桌面端「设置 → 切换存储」写密码时不会落明文，而是写成 DB_PASSWORD_ENC（系统加密，
# Windows 走 DPAPI）；托管启动与工具子进程用的明文由桌面端解密后注入。
# 手动跑 uvicorn 时若报「DB_PASSWORD 在配置里是加密存储的」，在上面临时写一行明文即可。
# 允许连接非本机 MySQL（1 = 允许，默认不允许）：置 1 表示聊天记录会离开本机
# DB_ALLOW_REMOTE=
# MySQL 服务端 CA 证书路径：填了走 TLS，并同时校验证书链与主机名（远程库跨公网时必填）
# DB_SSL_CA=
# 只放宽「主机名校验」（证书链仍然校验），仅在连本机自签证书的 MySQL 时使用：
# 官方 mysql 镜像的自签证书 CN 是 MySQL_Server_8.0.x，用 127.0.0.1 连必然主机名不匹配。
# 置 1 会在后端日志里留一条 WARN；公网库不要开。
# DB_SSL_NO_VERIFY_IDENTITY=

# ---------- 数据目录 ----------
# 留空 = backend/data；打包版由桌面端指向 userData/data
# SQLite 文件（data/suixinwenda.db）与附件（data/uploads/）都在这里
DATA_DIR=

# ---------- 认证 ----------
# JWT 签名密钥（必填，长度至少 32 位）
#   用根目录 start.ps1 启动时会自动生成并写回本文件，不用管
#   手动启动时留空会导致后端报「缺少配置项：JWT_SECRET」，自行生成：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 令牌有效期（秒），默认 7 天
JWT_EXPIRE_SECONDS=604800
# 演示固定验证码（选填）：注册已不需要验证码，这两项只服务于 /send_code 与 /login_by_code
#   填了 → 所有账号都用这个固定码（只在做验证码演示或自动化复现时填）
#   留空（默认）→ 每次随机生成 6 位，只对当前账号有效、用过即失效
#   **不要填成 000000 / 123456 这类公开值**：它配合下面的回显开关等于「凭账号即可登录」
MOCK_CODE=
# 是否把验证码回显到响应体：0 = 不回显（默认，验证码只写服务端日志）
#   1 = 回显（仅本机演示用；此时任何能访问本机端口的人都能登录任意账号）
DEMO_CODE_MODE=0
# 验证码有效期（秒）
CODE_EXPIRE_SECONDS=300
# 慢哈希预算（选填）：注册、登录、账号不存在时的假校验都要跑 60 万次 PBKDF2，
#   这是与账号无关的全局闸，一分钟内最多做多少次，超出返回 429。
#   正常使用一分钟不可能触发；调大只在压测/自动化场景有意义，留空用默认 30
AUTH_BUDGET_PER_MINUTE=

# ---------- 大模型 ----------
# 必填：DeepSeek 开放平台申请 https://platform.deepseek.com/
# 不填也能启动，但「模型列表」为空、聊天会返回中文提示
# 改完本文件后必须重启后端才生效（模型注册表在服务启动时构建一次）
# 已有同名系统环境变量时以环境变量为准，本文件不会覆盖它
DEEPSEEK_API_KEY=
# 选填：阿里云百炼（通义千问）Key，填了才会多出一个 qwen-flash 模型
DASHSCOPE_API_KEY=
# 选填：自建代理 / 私有化部署改这两个地址，留空用官方默认地址
DEEPSEEK_BASE_URL=
QWEN_BASE_URL=
